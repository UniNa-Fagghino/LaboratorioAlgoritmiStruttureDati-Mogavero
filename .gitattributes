# ==============================================================================
# Normalizzazione fine riga (Line Endings)
# ==============================================================================
* text=auto eol=lf

# File di testo sorgente ed elaborati
*.java text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
makefile text eol=lf
*.sh text eol=lf

# Script PowerShell e Windows Batch
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# File binari generici
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.jar binary

# ==============================================================================
# Git Large File Storage (Git LFS)
# File binari e archivi
# ==============================================================================
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

